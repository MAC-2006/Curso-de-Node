# Copie este arquivo para ".env" e ajuste os valores antes de rodar localmente.
# Em produção (Vercel), configure essas mesmas variáveis em
# Project Settings -> Environment Variables (não use o .env lá).

# Porta em que o servidor local vai rodar (não é usada na Vercel)
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# Segredo usado para assinar os tokens de login (JWT).
# IMPORTANTE: troque por um valor longo e aleatório em produção.
# Gerar um valor forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio

# --- Supabase: banco de dados (Postgres) ---
# Em supabase.com -> seu projeto -> Project Settings -> Database -> Connection string.
# Para produção na Vercel, prefira a URI de "Connection pooling" (modo
# "Transaction", porta 6543) — funciona melhor com funções serverless.
# Para rodar localmente, a connection string direta (porta 5432) também serve.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Supabase: Storage (upload de vídeos das aulas) ---
# Em supabase.com -> seu projeto -> Project Settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Use a "service_role" key (secreta, NUNCA exponha no front-end) — é ela que
# dá ao backend permissão para gravar no bucket de vídeos.
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key

# Nome do bucket de Storage usado para os vídeos das aulas (crie um bucket
# público com esse nome no painel do Supabase antes do primeiro deploy).
SUPABASE_VIDEOS_BUCKET=videos
